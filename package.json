{
  "name": "sondara",
  "description": "Open-source AI customer discovery and personal growth workspace for local or multi-user cloud deployment.",
  "license": "MIT",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n WEB,API -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed:dev": "tsx server/db/seed-dev.ts",
    "setup": "node scripts/setup.mjs",
    "test:auth-2fa": "tsx server/tests/auth-2fa.integration.ts",
    "test:ai-client": "tsx server/tests/ai-client.integration.ts",
    "test:search-connector": "tsx server/tests/search-connector.integration.ts",
    "test:map-connector": "tsx server/tests/map-connector.integration.ts",
    "test:contact-enrichment": "tsx server/tests/contact-enrichment.integration.ts",
    "test:closed-loop": "tsx server/tests/closed-loop.integration.ts",
    "test:industry-source": "tsx server/tests/industry-source.integration.ts",
    "test:content-assets": "tsx server/tests/content-assets.integration.ts",
    "test:campaigns": "tsx server/tests/campaigns.integration.ts",
    "test:inbox": "tsx server/tests/inbox.integration.ts",
    "test:outbox": "tsx server/tests/outbox.integration.ts",
    "test:partial-updates": "tsx server/tests/partial-updates.integration.ts",
    "test:icp": "tsx server/tests/icp.integration.ts",
    "test:attribution": "tsx server/tests/attribution.integration.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "build:web": "tsc -b && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "start": "node server-dist/index.js",
    "start:api": "node server-dist/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "smoke:production": "tsx server/tests/production-smoke.integration.ts",
    "qa:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "qa:ui-framework": "node scripts/check-ui-framework.mjs",
    "qa:public-repo": "node scripts/check-public-repo.mjs",
    "qa:e2e": "npm run build && node scripts/run-e2e.mjs",
    "qa:smoke": "npm run build && npm run smoke:production",
    "qa:all": "npm run qa:public-repo && npm run qa:ui-framework && npm run typecheck && npm run build && npm run qa:bundle-budget && node scripts/run-e2e.mjs && npm run smoke:production && npm run test:all",
    "test:all": "node scripts/run-integration-tests.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "@types/mailparser": "^3.4.6",
    "antd": "^6.6.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "fastify": "^5.12.0",
    "imapflow": "^1.7.1",
    "lucide-react": "1.31.0",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "smtp-server": "^3.19.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "html-to-text": "10.0.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  },
  "optionalDependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^10.70.0"
  }
}
