# ── 服务监听 ──
SONDARA_API_HOST=127.0.0.1
SONDARA_API_PORT=4176
NODE_ENV=production

# ── 数据库 ──
# SQLite 单文件数据库；相对路径以项目根目录为基准。
SONDARA_DATABASE_PATH=./data/sondara.sqlite

# ── Web 来源（CORS + Cookie） ──
SONDARA_WEB_ORIGIN=https://your-domain.example
SONDARA_SECURE_COOKIES=true
SONDARA_SESSION_DAYS=30
# 本地 HTTP 调试可设为 false；HTTPS 生产环境必须保持 true。
SONDARA_TRUST_PROXY=false

# ── 日志级别（fatal/error/warn/info/debug/trace） ──
SONDARA_LOG_LEVEL=info

# ── 数据库迁移与后台 Worker ──
SONDARA_AUTO_MIGRATE=true
# SQLite 版本面向单机/单实例部署；进程内锁确保后台任务不重复执行。
SONDARA_WORKER_LEADER_LOCK=true
SONDARA_WORKER_LEADER_ELECTION_INTERVAL_MS=30000

# ── 后台 Worker ──
SONDARA_RADAR_WORKER_ENABLED=true
SONDARA_RADAR_WORKER_INTERVAL_MS=2000
SONDARA_OUTBOX_WORKER_ENABLED=true
SONDARA_EXTERNAL_CONNECTOR_WORKER_ENABLED=true
SONDARA_EXTERNAL_CONNECTOR_WORKER_INTERVAL_MS=30000
SONDARA_SALES_GUARDIAN_ENABLED=true
SONDARA_SALES_GUARDIAN_INTERVAL_MS=60000
SONDARA_OUTBOX_WORKER_INTERVAL_MS=5000
SONDARA_BACKUP_ENABLED=true
SONDARA_BACKUP_INTERVAL_MS=86400000
SONDARA_BACKUP_RETENTION_COUNT=7
# 留空时默认使用项目下的 data/backups；也可设置绝对路径
SONDARA_BACKUP_DIRECTORY=

# ── 入站邮件 Worker（默认开启；每个邮箱优先在管理界面单独配置） ──
SONDARA_IMAP_ENABLED=true
SONDARA_IMAP_HOST=
SONDARA_IMAP_PORT=993
SONDARA_IMAP_USER=
SONDARA_IMAP_PASSWORD=
SONDARA_IMAP_POLL_INTERVAL_MS=60000

# ── 安全 ──
# 仅在可信的单租户/本地网络中，为自建 SearXNG 等服务开启
SONDARA_ALLOW_PRIVATE_CONNECTORS=false
# 生产环境请设置长期稳定的随机值（32+ 字节）；未设置时本地会生成 data/.master-key
SONDARA_ENCRYPTION_KEY=
SONDARA_RATE_LIMIT_MAX=300
# LinkedIn Marketing API 版本（YYYYMM）；升级前按官方迁移指南验证。
SONDARA_LINKEDIN_API_VERSION=202606

# ── 版本（可选，由 CI 注入） ──
SONDARA_VERSION=0.1.0

# ── 可观测性（可选，默认关闭） ──
# 依赖已随项目提供；填写配置后重启即可启用。
SONDARA_SENTRY_DSN=
SONDARA_SENTRY_TRACES_SAMPLE_RATE=0.1
SONDARA_OTEL_EXPORTER_OTLP_ENDPOINT=
SONDARA_OTEL_SERVICE_NAME=sondara
